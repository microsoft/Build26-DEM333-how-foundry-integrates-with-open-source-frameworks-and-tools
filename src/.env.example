# Load with `uv run --env-file .env ...` or `set -a && . ./.env && set +a`.
AZURE_SUBSCRIPTION_TENANT_ID=<AZURE_SUBSCRIPTION_TENANT_ID>
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
APPLICATION_INSIGHTS_CONNECTION_STRING=<APP_INSIGHTS_CONNECTION_STRING>

# Work IQ Mail MCP auth. For local runs, keep AZURE_TENANT_ID/AZURE_CLIENT_ID
# set to the Work IQ public-client app because MSAL-based libraries may read
# those standard names directly. Hosted deployments should pass DEM333_WORK_IQ_*
# and avoid overriding AZURE_CLIENT_ID.
AZURE_TENANT_ID=<WORK_IQ_TENANT_ID>
AZURE_CLIENT_ID=<WORK_IQ_PUBLIC_CLIENT_ID>
DEM333_WORK_IQ_TENANT_ID=<WORK_IQ_TENANT_ID>
DEM333_WORK_IQ_CLIENT_ID=<WORK_IQ_PUBLIC_CLIENT_ID>
DEM333_ENABLE_INTERACTIVE_AUTH=true
# DEM333_MSAL_CACHE_B64="$(base64 < ~/.dem333/msal_token_cache.json | tr -d '\n')"

# The main DEM333 agent intentionally uses init_chat_model("openai:gpt-5.2").
# Set OpenAI-compatible endpoint/auth when running outside a preconfigured environment.
# OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# OPENAI_API_KEY=<API_KEY>
