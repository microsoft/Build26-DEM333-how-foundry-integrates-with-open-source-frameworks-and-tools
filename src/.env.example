# Automatically loaded by `uv run` (UV_ENV_FILE defaults to .env)
AZURE_TENANT_ID=<TENANT_ID>
AZURE_CLIENT_ID=<CLIENT_ID>
AZURE_AI_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
APPLICATION_INSIGHTS_CONNECTION_STRING=<APP_INSIGHTS_CONNECTION_STRING>

# The main DEM333 agent intentionally uses init_chat_model("openai:gpt-5.2").
# Set OpenAI-compatible endpoint/auth when running outside a preconfigured environment.
# OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# OPENAI_API_KEY=<API_KEY>
